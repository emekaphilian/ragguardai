RAGGUARD_ENV=development
RAGGUARD_TOP_K=5
RAGGUARD_MIN_CONTEXT_PRECISION=0.70
RAGGUARD_MIN_CONTEXT_RECALL=0.70
RAGGUARD_MIN_FAITHFULNESS=0.70
RAGGUARD_MIN_ANSWER_RELEVANCY=0.70

# Service-to-service authentication for POST /api/v1/observations.
RAGGUARD_SERVICE_TOKEN=change-me
RAGGUARD_SERVICE_APPLICATION=trustassist
RAGGUARD_SERVICE_TENANT=development

# Recovery audit storage defaults to in-memory. PostgreSQL is opt-in.
RAGGUARD_AUDIT_BACKEND=memory
# RAGGUARD_DATABASE_URL=postgresql://ragguard:change-me@localhost:5432/ragguard
RAGGUARD_AUDIT_RETENTION_DAYS=90
RAGGUARD_AUDIT_MAX_PAGE_SIZE=100
RAGGUARD_EVENT_RETENTION_DAYS=30
