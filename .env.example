RAGGUARD_ENV=development
# Explicit local/test setting only. Production must use a verified provider.
RAGGUARD_AUTH_MODE=development_headers
RAGGUARD_TOP_K=5
RAGGUARD_MIN_CONTEXT_PRECISION=0.70
RAGGUARD_MIN_CONTEXT_RECALL=0.70
RAGGUARD_MIN_FAITHFULNESS=0.70
RAGGUARD_MIN_ANSWER_RELEVANCY=0.70

# Service-to-service authentication for POST /api/v1/observations.
RAGGUARD_SERVICE_TOKEN=change-me
RAGGUARD_SERVICE_APPLICATION=ragguard
RAGGUARD_SERVICE_TENANT=development

# Optional separate credential for deliberate administrative history clearing.
# Keep this secret server-side; never expose it through a VITE_ variable.
# RAGGUARD_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Registered application management uses the same server-side admin token.
# In production, dashboard administration uses OIDC sessions instead.
# External adapter credentials are referenced by variable name in PostgreSQL;
# store their values only in the hosting environment, never in this file.
# SUPPORTBOT_QUERY_TOKEN=replace-with-an-external-query-token
# CUSTOMERBOT_OBSERVATION_TOKEN=replace-with-an-observation-token

# Recovery audit storage defaults to in-memory. PostgreSQL is opt-in.
RAGGUARD_AUDIT_BACKEND=memory
# RAGGUARD_DATABASE_URL=postgresql://ragguard:change-me@localhost:5432/ragguard

# OIDC production configuration (all secrets stay on the API host).
# RAGGUARD_AUTH_MODE=oidc
# RAGGUARD_OIDC_ISSUER=https://identity-provider-issuer
# RAGGUARD_OIDC_CLIENT_ID=ragguard-client-id
# RAGGUARD_OIDC_CLIENT_SECRET=server-side-client-secret
# RAGGUARD_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# RAGGUARD_OIDC_REDIRECT_URI=https://api.example.com/api/v1/auth/callback
# RAGGUARD_FRONTEND_URL=https://dashboard.example.com
# RAGGUARD_FRONTEND_ORIGINS=https://dashboard.example.com
# RAGGUARD_SESSION_SECRET=generate-at-least-32-random-characters
# RAGGUARD_OIDC_BOOTSTRAP_ADMIN_SUBJECT=exact-id-token-sub
# RAGGUARD_OIDC_BOOTSTRAP_ADMIN_TENANT=development
# For separate cross-site frontend/API origins, set SameSite=None; Secure remains true.
# RAGGUARD_SESSION_COOKIE_SAMESITE=lax
# RAGGUARD_AUDIT_BACKEND=postgres
RAGGUARD_AUDIT_RETENTION_DAYS=90
RAGGUARD_AUDIT_MAX_PAGE_SIZE=100
RAGGUARD_EVENT_RETENTION_DAYS=30
